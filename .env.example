# Секреты бэкенда (n8n credentials сейчас / Docker .env потом).
# Этот файл — только шаблон. Настоящий .env в git не коммитится.

PYRUS_LOGIN=
PYRUS_SECURITY_KEY=

MANGO_API_KEY=
MANGO_API_SALT=
MANGO_SMS_FROM_EXTENSION=
MANGO_SMS_SENDER=

# Случайная строка 32+ символов: HMAC для кодов входа и сессий
AUTH_CODE_SECRET=

# Домен фронта для CORS
ALLOWED_ORIGIN=https://example.com
